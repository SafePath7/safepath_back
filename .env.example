POSTGRES_DB=safepath
POSTGRES_USER=safepath_local
POSTGRES_PASSWORD=replace_with_a_local_development_password
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/user/firebase-keys/firebase-service-account.json
# Compose에서만 사용하는 호스트 경로. 위 로컬 실행 경로와 같은 JSON을 지정할 수 있습니다.
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-service-account.json
AI_PROJECT_PATH=../safepath_AI
SAFEPATH_PHONE_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
SAFEPATH_PHONE_HASH_KEY=replace_with_a_different_base64_encoded_32_byte_key
AI_BACKEND_KEY=
SAFEPATH_AI_INTERNAL_KEY=
AI_API_KEY=

SAFEPATH_SECURITY_LIGHT_API_KEY=replace_with_a_data_go_kr_service_key
SAFEPATH_SECURITY_LIGHT_SYNC_ENABLED=false

SAFEPATH_CCTV_API_KEY=replace_with_a_data_go_kr_service_key
SAFEPATH_CCTV_SYNC_ENABLED=false
SAFEPATH_CCTV_SYNC_MAX_PAGES=0

SAFEPATH_EMERGENCY_CALL_BOX_API_KEY=replace_with_a_data_go_kr_service_key
SAFEPATH_EMERGENCY_CALL_BOX_SYNC_ENABLED=false
SAFEPATH_EMERGENCY_CALL_BOX_SYNC_MAX_PAGES=0

SAFEPATH_POLICE_STATION_API_KEY=replace_with_a_safemap_service_key
SAFEPATH_POLICE_STATION_SYNC_ENABLED=false
SAFEPATH_POLICE_STATION_SYNC_MAX_PAGES=0

SAFEPATH_SAFETY_GUARDIAN_STORE_API_KEY=replace_with_a_data_go_kr_service_key
SAFEPATH_SAFETY_GUARDIAN_STORE_SYNC_ENABLED=false
SAFEPATH_SAFETY_GUARDIAN_STORE_SYNC_MAX_PAGES=0

MAPBOX_ACCESS_TOKEN=
